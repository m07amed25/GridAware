{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gridaware.example/telemetry-envelope-1.0.json",
  "title": "GridAware Telemetry Envelope v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "deviceId",
    "observedAt",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "simulationRunId": {
      "type": "string",
      "format": "uuid"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensorId",
          "metricCode",
          "value",
          "unit"
        ],
        "properties": {
          "sensorId": {
            "type": "string",
            "format": "uuid"
          },
          "metricCode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceQuality": {
            "type": "string",
            "enum": [
              "GOOD",
              "UNCERTAIN",
              "BAD"
            ]
          }
        }
      }
    }
  }
}
