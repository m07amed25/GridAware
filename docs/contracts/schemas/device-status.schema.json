{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gridaware.example/device-status-1.0.json",
  "title": "GridAware Device Status v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deviceId",
    "status",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "ONLINE",
        "DEGRADED",
        "OFFLINE",
        "MAINTENANCE"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    }
  }
}
