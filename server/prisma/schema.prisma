// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SessionRevokeReason {
  USER_LOGOUT
  USER_LOGOUT_ALL
  USER_SESSION_REVOKE
  PASSWORD_RESET
  TOKEN_REUSE
  MAX_SESSIONS_EVICTED
  ACCOUNT_STATE_CHANGE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  FACILITY_MANAGER
  ENGINEER
  TECHNICIAN
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SiteType {
  FACTORY
  INDUSTRIAL_FACILITY
  COMMERCIAL_COMPLEX
  COMMERCIAL_PROPERTY
  CAMPUS
  WAREHOUSE_CAMPUS
  OTHER
}

enum BuildingType {
  PRODUCTION
  OFFICE
  WAREHOUSE
  UTILITY
  RETAIL
  PLANT_ROOM
  PARKING
  OTHER
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @db.VarChar(254)
  normalizedEmail String     @unique @db.VarChar(254)
  displayName     String     @db.VarChar(120)
  passwordHash    String
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  sessions            AuthSession[]
  emailVerifications  EmailVerificationToken[]
  passwordResets      PasswordResetToken[]
  memberships         Membership[]
  sentInvitations     OrganizationInvitation[] @relation("InvitationSender")
  acceptedInvitations OrganizationInvitation[] @relation("InvitationAcceptor")
  auditLogs           AuditLog[]               @relation("AuditActor")
  createdDevices      Device[]                 @relation("DeviceCreator")
  createdCredentials  DeviceCredential[]       @relation("CredentialCreator")
  createdSensors      Sensor[]                 @relation("SensorCreator")
  sensorAssignments   DeviceSensorAssignment[] @relation("AssignmentCreator")

  @@index([status, createdAt])
  @@map("users")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(120)
  slug      String             @unique @db.VarChar(80)
  status    OrganizationStatus @default(ACTIVE)
  timezone  String             @default("UTC") @db.VarChar(64)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  invitations OrganizationInvitation[]
  sites       Site[]
  buildings   Building[]
  assets      Asset[]
  devices     Device[]
  sensors     Sensor[]
  auditLogs   AuditLog[]

  @@index([status, createdAt])
  @@map("organizations")
}

model OrganizationInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  email            String           @db.VarChar(254)
  normalizedEmail  String           @db.VarChar(254)
  role             MembershipRole
  tokenHash        String           @unique @db.Char(64)
  status           InvitationStatus @default(PENDING)
  invitedByUserId  String           @db.Uuid
  acceptedByUserId String?          @db.Uuid
  expiresAt        DateTime         @db.Timestamptz(6)
  acceptedAt       DateTime?        @db.Timestamptz(6)
  revokedAt        DateTime?        @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, normalizedEmail, status])
  @@map("organization_invitations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  suspendedAt    DateTime?        @db.Timestamptz(6)
  removedAt      DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]   @relation("AuditActorMembership")

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, userId, status])
  @@index([organizationId, role, status])
  @@index([userId, status])
  @@map("memberships")
}

model AuthSession {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @db.Uuid
  refreshTokenHash  String               @unique @db.Char(64)
  userAgent         String?              @db.VarChar(512)
  ipHash            String?              @db.Char(64)
  lastUsedAt        DateTime             @default(now()) @db.Timestamptz(6)
  idleExpiresAt     DateTime             @db.Timestamptz(6)
  absoluteExpiresAt DateTime             @db.Timestamptz(6)
  revokedAt         DateTime?            @db.Timestamptz(6)
  revokedReason     SessionRevokeReason?
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, idleExpiresAt])
  @@index([userId, lastUsedAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(6)
  usedAt        DateTime? @db.Timestamptz(6)
  invalidatedAt DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, invalidatedAt, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(6)
  usedAt        DateTime? @db.Timestamptz(6)
  invalidatedAt DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, invalidatedAt, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String?  @db.Uuid
  actorUserId       String?  @db.Uuid
  actorMembershipId String?  @db.Uuid
  action            String   @db.VarChar(80)
  entityType        String   @db.VarChar(60)
  entityId          String?  @db.VarChar(128)
  requestId         String?  @db.VarChar(128)
  correlationId     String?  @db.VarChar(128)
  metadata          Json?
  occurredAt        DateTime @default(now()) @db.Timestamptz(6)

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser       User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership Membership?   @relation("AuditActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([organizationId, action, occurredAt])
  @@index([action, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

model Site {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  code           String         @db.VarChar(32)
  name           String         @db.VarChar(120)
  type           SiteType
  description    String?        @db.VarChar(2000)
  addressLine1   String?        @db.VarChar(200)
  addressLine2   String?        @db.VarChar(200)
  city           String?        @db.VarChar(200)
  region         String?        @db.VarChar(200)
  postalCode     String?        @db.VarChar(32)
  countryCode    String?        @db.VarChar(2)
  latitude       Float?
  longitude      Float?
  timeZone       String         @default("UTC") @db.VarChar(64)
  status         LocationStatus @default(ACTIVE)
  archivedAt     DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  buildings    Building[]
  assets       Asset[]
  devices      Device[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status, archivedAt, createdAt])
  @@index([organizationId, city])
  @@map("sites")
}

model Building {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  siteId         String         @db.Uuid
  code           String         @db.VarChar(32)
  name           String         @db.VarChar(120)
  type           BuildingType
  description    String?        @db.VarChar(2000)
  floorCount     Int?
  grossAreaSqM   Decimal?       @db.Decimal(12, 2)
  status         LocationStatus @default(ACTIVE)
  archivedAt     DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assets       Asset[]

  @@unique([id, organizationId])
  @@unique([id, siteId, organizationId])
  @@unique([siteId, code])
  @@index([organizationId, siteId, status, archivedAt, createdAt])
  @@index([organizationId, status])
  @@map("buildings")
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  DECOMMISSIONED
}

enum DeviceType {
  GATEWAY
  SIMULATOR
  EDGE_CONTROLLER
  OTHER
}

enum DeviceStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  RETIRED
}

enum CredentialType {
  PASSWORD
  CERTIFICATE
}

enum CredentialStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
}

enum SensorStatus {
  PLANNED
  ACTIVE
  MAINTENANCE
  DISABLED
  RETIRED
}

enum AssignmentStatus {
  ACTIVE
  REVOKED
}

enum MetricValueType {
  NUMERIC
}

model Asset {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  siteId         String      @db.Uuid
  buildingId     String?     @db.Uuid
  assetCode      String      @db.VarChar(80)
  name           String      @db.VarChar(120)
  assetType      String      @db.VarChar(60)
  status         AssetStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  building     Building?    @relation(fields: [buildingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  devices      Device[]
  sensors      Sensor[]

  @@unique([organizationId, assetCode])
  @@unique([id, organizationId])
  @@index([organizationId, siteId])
  @@map("assets")
}

model Device {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  siteId             String?      @db.Uuid
  assetId            String?      @db.Uuid
  deviceKey          String       @db.VarChar(100)
  name               String       @db.VarChar(120)
  description        String?      @db.VarChar(500)
  deviceType         DeviceType   @default(SIMULATOR)
  status             DeviceStatus @default(PENDING)
  serialNumber       String?      @db.VarChar(120)
  manufacturer       String?      @db.VarChar(120)
  model              String?      @db.VarChar(120)
  firmwareVersion    String?      @db.VarChar(80)
  metadata           Json?
  lastSeenAt         DateTime?    @db.Timestamptz(6)
  lastConnectedAt    DateTime?    @db.Timestamptz(6)
  lastDisconnectedAt DateTime?    @db.Timestamptz(6)
  revokedAt          DateTime?    @db.Timestamptz(6)
  createdById        String       @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site?                    @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  asset        Asset?                   @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User                     @relation("DeviceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  credentials  DeviceCredential[]
  assignments  DeviceSensorAssignment[]

  @@unique([organizationId, deviceKey])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastSeenAt])
  @@map("devices")
}

model DeviceCredential {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  deviceId          String           @db.Uuid
  credentialVersion Int
  credentialType    CredentialType   @default(PASSWORD)
  secretHash        String           @db.Text
  status            CredentialStatus @default(ACTIVE)
  issuedAt          DateTime         @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime?        @db.Timestamptz(6)
  lastUsedAt        DateTime?        @db.Timestamptz(6)
  revokedAt         DateTime?        @db.Timestamptz(6)
  createdById       String           @db.Uuid
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)

  device    Device @relation(fields: [deviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy User   @relation("CredentialCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([deviceId, credentialVersion])
  @@index([organizationId, deviceId, status])
  @@map("device_credentials")
}

model Sensor {
  id                               String       @id @default(uuid()) @db.Uuid
  organizationId                   String       @db.Uuid
  assetId                          String       @db.Uuid
  sensorKey                        String       @db.VarChar(120)
  name                             String       @db.VarChar(120)
  description                      String?      @db.VarChar(500)
  sensorType                       String       @db.VarChar(80)
  status                           SensorStatus @default(PLANNED)
  installationLocation             String?      @db.VarChar(160)
  manufacturer                     String?      @db.VarChar(120)
  model                            String?      @db.VarChar(120)
  serialNumber                     String?      @db.VarChar(120)
  samplingIntervalSeconds          Int?
  expectedReportingIntervalSeconds Int?
  lastReadingAt                    DateTime?    @db.Timestamptz(6)
  createdById                      String       @db.Uuid
  createdAt                        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                        DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset        Asset                    @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User                     @relation("SensorCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments  DeviceSensorAssignment[]
  metrics      SensorMetric[]

  @@unique([organizationId, sensorKey])
  @@unique([id, organizationId])
  @@index([organizationId, assetId])
  @@index([organizationId, status])
  @@map("sensors")
}

model MetricDefinition {
  key            String          @id @db.VarChar(80)
  displayName    String          @db.VarChar(120)
  description    String          @db.VarChar(500)
  dimension      String          @db.VarChar(60)
  canonicalUnit  String          @db.VarChar(20)
  supportedUnits String[]
  valueType      MetricValueType @default(NUMERIC)
  isActive       Boolean         @default(true)

  sensorMetrics SensorMetric[]

  @@map("metric_definitions")
}

model SensorMetric {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  sensorId          String   @db.Uuid
  metricKey         String   @db.VarChar(80)
  unit              String   @db.VarChar(20)
  precision         Int?
  minPlausibleValue Float?
  maxPlausibleValue Float?
  isPrimary         Boolean  @default(true)
  configuration     Json?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  sensor           Sensor           @relation(fields: [sensorId, organizationId], references: [id, organizationId], onDelete: Cascade)
  metricDefinition MetricDefinition @relation(fields: [metricKey], references: [key], onDelete: Restrict)

  @@unique([sensorId, metricKey])
  @@index([organizationId, sensorId])
  @@map("sensor_metrics")
}

model DeviceSensorAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  deviceId       String           @db.Uuid
  sensorId       String           @db.Uuid
  status         AssignmentStatus @default(ACTIVE)
  assignedAt     DateTime         @default(now()) @db.Timestamptz(6)
  unassignedAt   DateTime?        @db.Timestamptz(6)
  assignedById   String           @db.Uuid

  device     Device @relation(fields: [deviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sensor     Sensor @relation(fields: [sensorId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignedBy User   @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([organizationId, sensorId, status])
  @@index([organizationId, deviceId, status])
  @@map("device_sensor_assignments")
}
