# Runtime environment (development | production | test)
NODE_ENV=development
PORT=3001
# Single origin or comma-separated http(s) origins (no trailing path)
CORS_ORIGIN=http://localhost:3000
# Enable interactive Swagger UI at /api/docs (true | false, default true)
# SWAGGER_ENABLED=true
# Optional logging overrides (defaults: debug+pretty in dev, log+json in prod)
# LOG_LEVEL=debug
# LOG_FORMAT=pretty
# Optional per-dependency timeout (ms) for GET /api/v1/health/ready (100..30000, default 2000)
# HEALTH_CHECK_TIMEOUT_MS=2000

# Neon PostgreSQL (pooled URL for runtime via @prisma/adapter-neon)
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon PostgreSQL (direct unpooled URL for Prisma CLI / migrations)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Local infrastructure (Docker Compose overrides these with service hostnames)
REDIS_URL="redis://localhost:6379"
MQTT_URL="mqtt://localhost:1883"
# Optional MQTT broker credentials
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Optional NestJS Observe telemetry (run `npx @nestjs/observe link` to populate)
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_ENDPOINT=https://observe-api.nestjs.com

# Phase 5.1 Authentication & Identity Management
# Required in production (minimum 32 characters)
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters-in-dev
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_SESSION_IDLE_TTL_DAYS=14
AUTH_SESSION_ABSOLUTE_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS=10
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=gridaware-web

# Cookie attributes (COOKIE_SECURE defaults to true in production, false in dev/test)
# COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# Dual-key Redis auth rate-limiting thresholds
AUTH_RATE_LIMIT_WINDOW_SEC=900
AUTH_RATE_LIMIT_LOGIN_IP_MAX=10
AUTH_RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
AUTH_RATE_LIMIT_REGISTER_IP_MAX=5
AUTH_RATE_LIMIT_REGISTER_ACCOUNT_MAX=3
AUTH_RATE_LIMIT_VERIFY_IP_MAX=5
AUTH_RATE_LIMIT_VERIFY_ACCOUNT_MAX=3
AUTH_RATE_LIMIT_RESET_IP_MAX=5
AUTH_RATE_LIMIT_RESET_ACCOUNT_MAX=3
AUTH_RATE_LIMIT_REFRESH_WINDOW_SEC=300
AUTH_RATE_LIMIT_REFRESH_IP_MAX=30

# Transactional mail ("console" is blocked in production; use "smtp", "resend", or "http")
MAIL_PROVIDER=console
MAIL_FROM=no-reply@gridaware.local
# SMTP settings (required when MAIL_PROVIDER=smtp, e.g. Google SMTP with an App Password)
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true
# MAIL_SMTP_USER=your-account@gmail.com
# MAIL_SMTP_PASS=your-16-char-google-app-password
# HTTP provider settings (required when MAIL_PROVIDER=resend or http)
# MAIL_API_KEY=
# MAIL_API_URL=
APP_URL=http://localhost:3000

OWNER_EMAIL=m07hamedreda25@gmail.com
