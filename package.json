{
  "name": "gridware",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c cyan,magenta --kill-others-on-fail \"pnpm --filter client dev\" \"pnpm --filter server start:dev\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "contracts:validate": "pnpm --filter server contracts:validate",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml watch",
    "docker:infra": "docker compose up -d redis mosquitto",
    "docker:logs": "docker compose logs -f",
    "simulate": "pnpm --filter server simulate --"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
